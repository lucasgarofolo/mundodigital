PORT=3000
# Local: development. No host: production, DATA_DIR=/data (volume privado real),
# APP_ORIGIN=https://seu-dominio.example e TRUST_PROXY conforme o proxy confiável.
NODE_ENV=development
DATA_DIR=data
APP_ORIGIN=
TRUST_PROXY=
# local: default LPC; gemini: Google API; ollama: local vision model; openrouter: multimodal API.
AVATAR_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_AVATAR_MODEL=qwen/qwen3-vl-30b-a3b-instruct
# Total analysis budget, shared by the central pipeline's calls and retry delay; 0 disables the deadline.
OPENROUTER_AVATAR_TIMEOUT_MS=30000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# 0 waits for the provider response without a local deadline; default is 180000 ms.
GEMINI_TIMEOUT_MS=0
# Log validated visual attributes in the server terminal (default on outside production).
GEMINI_LOG_RESPONSE=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:12b
OLLAMA_TIMEOUT_MS=0
OLLAMA_LOG_RESPONSE=false
WORLD_ENTRY_DELAY_MS=8000
WORLD_ENTRY_SPACING_MS=1000
AVATAR_MAX_ATTEMPTS=2
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_PORTRAIT_MODEL=@cf/black-forest-labs/flux-2-klein-4b
CLOUDFLARE_PORTRAIT_TIMEOUT_MS=120000
PASS_PORTRAIT_WAIT_MS=15000
EVENT_EDITION=2026
EVENT_INSTAGRAM_HANDLE=
EVENT_HASHTAG="#MundoDigital"
PASS_DEFAULT_ROLE=
PASS_DEFAULT_ORGANIZATION=
# Local: Chrome instalado. Linux/cloud: chromium e instalação no build:
# PLAYWRIGHT_BROWSERS_PATH=0 npx playwright install --with-deps chromium
# Configure PLAYWRIGHT_BROWSERS_PATH=0 no build E no runtime do host.
STORY_BROWSER_CHANNEL=chrome
# PLAYWRIGHT_BROWSERS_PATH=0
# Obrigatório: gere com node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
SESSION_MAX_AGE_HOURS=12
# APP_ORIGIN: obrigatório em produção, origem HTTPS exata, sem barra final.
# TRUST_PROXY: loopback se proxy local; 1 SOMENTE se houver um hop confiável
# e a porta direta do Node estiver isolada. Não usar confiança irrestrita.

# Opcional: política completa para o link no aviso da selfie (HTTPS ou caminho local).
SELFIE_PRIVACY_POLICY_URL=
# Opcional somente para CA corporativa verificada; lida pelo Node no lançamento.
# NODE_EXTRA_CA_CERTS=/caminho/ca-confiavel.pem
